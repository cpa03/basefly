From f3981bea5007f8a0ca164676db0b2fda85917fb4 Mon Sep 17 00:00:00 2001
From: cpa03 <245960241+cpa03@users.noreply.github.com>
Date: Fri, 31 Jul 2026 20:53:22 +0000
Subject: [PATCH] fix(ci): restore pnpm migration in iterate.yml

The npm-to-pnpm migration (previously applied in cd9eb30) was lost
when a stale branch was merged over it. This restores pnpm usage in
both the architect and fixer jobs:

- Replace npm ci with pnpm/action-setup@v6 + pnpm install --frozen-lockfile
- Update cache path from ~/.npm to ~/.local/share/pnpm/store
- Update cache key from package-lock.json to pnpm-lock.yaml
- Enable setup-node pnpm cache

Resolves the pnpm consistency regression reported in #744, #670
(also related: #305, #584, #595)
---
 .github/workflows/iterate.yml | 18 ++++++++++++++----
 1 file changed, 14 insertions(+), 4 deletions(-)

diff --git a/.github/workflows/iterate.yml b/.github/workflows/iterate.yml
index 1dbebf9..82dd288 100644
--- a/.github/workflows/iterate.yml
+++ b/.github/workflows/iterate.yml
@@ -55,8 +55,8 @@ jobs:
         with:
           path: |
             ~/.opencode
-            ~/.npm
-          key: opencode-${{ runner.os }}-${{ hashFiles('**/package-lock.json') }}-v1
+            ~/.local/share/pnpm/store
+          key: opencode-${{ runner.os }}-${{ hashFiles('**/pnpm-lock.yaml') }}-v1
           restore-keys: |
             opencode-${{ runner.os }}-v1
 
@@ -65,11 +65,16 @@ jobs:
           git config --global user.name "${{ github.actor }}"
           git config --global user.email "${{ github.actor_id }}+${{ github.actor }}@users.noreply.github.com"
 
+      - uses: pnpm/action-setup@v6
+        with:
+          run_install: false
+
       - uses: actions/setup-node@v7
         with:
           node-version: "20"
+          cache: 'pnpm'
 
-      - run: npm ci || true
+      - run: pnpm install --frozen-lockfile || true
 
       - name: Install OpenCode
         run: |
@@ -335,11 +340,16 @@ jobs:
           git config --global user.name "${{ github.actor }}"
           git config --global user.email "${{ github.actor_id }}+${{ github.actor }}@users.noreply.github.com"
 
+      - uses: pnpm/action-setup@v6
+        with:
+          run_install: false
+
       - uses: actions/setup-node@v7
         with:
           node-version: "20"
+          cache: 'pnpm'
 
-      - run: npm ci || true
+      - run: pnpm install --frozen-lockfile || true
 
       - name: Install OpenCode
         run: |
